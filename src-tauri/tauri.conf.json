{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Your Tasks",
  "version": "0.1.0",
  "identifier": "com.tahirahmed.react-todo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Your Tasks",
        "width": 1180,
        "height": 720,
        "minWidth": 720,
        "minHeight": 520,
        "zoomHotkeysEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
